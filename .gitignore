# Raw CMAPSS dataset — only the FD001 files needed by the live demo are tracked
data/raw/
*.parquet
CMAPSSData/*
!CMAPSSData/test_FD001.txt
!CMAPSSData/RUL_FD001.txt
!CMAPSSData/readme.txt

# Models — keep the trained XGBoost artefact + metadata for reproducible
# `docker build` / `streamlit run` on a fresh clone. Intermediate formats stay out.
models/*.pkl
models/*.ubj

# MLflow tracking artefacts (regenerated locally when retraining)
mlflow.db
notebooks/mlflow.db
mlruns/
mlartifacts/

