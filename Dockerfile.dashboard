# Streamlit dashboard + Agentic AI layer for Cloud Run.
#
# Includes the chat agent (GPT-4o-mini tool calling) and the LangGraph
# fleet monitoring multi-agent pipeline. OPENAI_API_KEY is injected at
# runtime via Secret Manager (see deploy command).
#
# Build context expects:
#   - src/                 (dashboard + agents + features.py)
#   - models/              (xgb_rul.joblib + model_meta.json)
#   - data/eda_meta.json   data/feature_meta.json
#   - CMAPSSData/test_FD001.txt  CMAPSSData/RUL_FD001.txt
#   - requirements.txt
#
# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=builder /install /usr/local

COPY src/                       ./src/
COPY models/                    ./models/
COPY data/eda_meta.json         ./data/eda_meta.json
COPY data/feature_meta.json     ./data/feature_meta.json
COPY CMAPSSData/test_FD001.txt  ./CMAPSSData/test_FD001.txt
COPY CMAPSSData/RUL_FD001.txt   ./CMAPSSData/RUL_FD001.txt

RUN useradd -m appuser && chown -R appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ENABLE_CORS=false \
    STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "streamlit run src/dashboard/app.py --server.port=$PORT --server.address=0.0.0.0"]
